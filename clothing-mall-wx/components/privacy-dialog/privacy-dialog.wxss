.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 3000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.privacy-panel {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}

.privacy-title {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: #222;
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-content {
  font-size: 28rpx;
  line-height: 44rpx;
  color: #555;
}

.privacy-link {
  color: #ff8096;
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.privacy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 0;
}

.privacy-btn::after {
  border: 0;
}

.privacy-btn.secondary {
  color: #666;
  background: #f5f5f5;
}

.privacy-btn.primary {
  color: #fff;
  background: #ff8096;
}
