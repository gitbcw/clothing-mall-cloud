@import "../../../styles/manager-common.wxss";

.container {
  min-height: 100vh;
  background-color: #F5F3F0;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ---- 导航栏 ---- */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24px);
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  position: relative;
}

.nav-back {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
}

.nav-back-icon {
  width: 18rpx; height: 18rpx;
  border-left: 3rpx solid #333;
  border-bottom: 3rpx solid #333;
  transform: rotate(45deg);
}

.nav-title {
  font-size: 34rpx; font-weight: 700; color: #1A1A1A;
  position: absolute; left: 50%; transform: translateX(-50%);
  letter-spacing: 1rpx;
}

.nav-action {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
}

.nav-add-icon {
  width: 26rpx; height: 26rpx; position: relative;
}

.nav-add-icon::before,
.nav-add-icon::after {
  content: ''; position: absolute; background: #FF8096; border-radius: 3rpx;
}

.nav-add-icon::before {
  width: 100%; height: 4rpx; top: 50%; transform: translateY(-50%);
}

.nav-add-icon::after {
  width: 4rpx; height: 100%; left: 50%; transform: translateX(-50%);
}

.nav-placeholder { background: transparent; }

/* ---- Tab 筛选（胶囊风格）---- */
.tab-scroll {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 99;
  margin-top: 0;
  background: #FFFFFF;
  white-space: nowrap;
  border-bottom: none;
}

.tab-list {
  display: inline-flex;
  padding: 16rpx 12rpx;
  gap: 8rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  color: #666;
  border-radius: 32rpx;
  transition: all 0.25s;
}

.tab-item.active {
  color: #FFFFFF;
  font-weight: 600;
  background: #FF8096;
  box-shadow: 0 4rpx 12rpx rgba(255, 128, 150, 0.35);
}

/* ---- 优惠券列表 ---- */
.coupon-list {
  padding: 20rpx 24rpx;
}

/* ---- 票券风格优惠券卡片 ---- */
.coupon-card {
  position: relative;
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: visible;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}

.coupon-card:active {
  transform: scale(0.985);
}

/* 半圆切口 */
.coupon-notch-top,
.coupon-notch-bottom {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #F5F3F0;
  z-index: 3;
  left: 188rpx;
}

.coupon-notch-top { top: -12rpx; }
.coupon-notch-bottom { bottom: -12rpx; }

/* 虚线分隔 */
.coupon-separator {
  position: absolute;
  left: 188rpx;
  top: 20rpx;
  bottom: 20rpx;
  width: 0;
  border-left: 2rpx dashed rgba(0, 0, 0, 0.06);
  z-index: 2;
}

/* 左侧：金额区 */
.coupon-left {
  width: 200rpx;
  background: linear-gradient(135deg, #FF8096, #FFB3C1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 16rpx;
  flex-shrink: 0;
  border-radius: 16rpx 0 0 16rpx;
  position: relative;
  overflow: hidden;
}

/* 斜纹装饰 */
.coupon-left::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: repeating-linear-gradient(
    45deg,
    transparent, transparent 8rpx,
    rgba(255,255,255,0.06) 8rpx, rgba(255,255,255,0.06) 16rpx
  );
}

/* 所有类型统一粉色 */

/* 状态：过期/下架半透明 */
.coupon-expired { opacity: 0.5; }
.coupon-off { opacity: 0.6; }

.coupon-amount {
  display: flex;
  align-items: baseline;
  position: relative;
  z-index: 1;
}

.amount-symbol {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.amount-value {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.1;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.amount-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.coupon-condition {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

/* 右侧：详情区 */
.coupon-right {
  flex: 1;
  padding: 24rpx 24rpx;
  min-width: 0;
}

.coupon-name {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 600;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 12rpx;
}

.coupon-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.coupon-type-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

/* 类型标签统一粉色 */
.tag-type-0, .tag-type-1, .tag-type-2, .tag-type-3, .tag-type-4 {
  background: rgba(255, 128, 150, 0.1);
  color: #FF8096;
}

.coupon-status-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.tag-normal { background: rgba(7, 193, 96, 0.1); color: #07c160; }
.tag-expired { background: rgba(153, 153, 153, 0.1); color: #999; }
.tag-off { background: rgba(232, 73, 74, 0.08); color: #E8494A; }

.coupon-limit {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-bottom: 4rpx;
}

.coupon-stock {
  font-size: 22rpx;
  color: #BBB;
  display: block;
}

.coupon-time {
  font-size: 20rpx;
  color: #CCC;
  display: block;
  margin-top: 4rpx;
}

/* 删除操作 */
.coupon-actions {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 20rpx 24rpx 0;
  flex-shrink: 0;
}

.action-btn {
  width: 52rpx; height: 52rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
}

.action-btn:active {
  background: rgba(232, 73, 74, 0.08);
}

.delete-icon {
  width: 18rpx; height: 18rpx; position: relative;
}

.delete-icon::before,
.delete-icon::after {
  content: ''; position: absolute; width: 100%; height: 3rpx;
  background: #CCC; top: 50%; left: 0; border-radius: 2rpx;
}

.delete-icon::before { transform: rotate(45deg); }
.delete-icon::after { transform: rotate(-45deg); }

.action-btn:active .delete-icon::before,
.action-btn:active .delete-icon::after {
  background: #E8494A;
}

/* ---- 加载更多/底部 ---- */
.load-more { text-align: center; padding: 30rpx; }
.load-more-text { font-size: 24rpx; color: #999; }
.list-end { text-align: center; padding: 30rpx; }
.list-end-text { font-size: 24rpx; color: #CCC; }

/* ---- 空状态 ---- */
.empty-state {
  display: flex; flex-direction: column; align-items: center; padding: 160rpx 40rpx;
}

.empty-icon {
  width: 140rpx; height: 140rpx; border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 128, 150, 0.12), rgba(255, 128, 150, 0.04));
  margin-bottom: 40rpx;
  position: relative;
}

/* 空状态图标上的小切口 */
.empty-icon::before {
  content: '';
  position: absolute;
  width: 20rpx; height: 20rpx;
  border-radius: 50%;
  background: #F5F3F0;
  right: -10rpx;
  top: 50%;
  transform: translateY(-50%);
}

.empty-text { font-size: 32rpx; color: #333; font-weight: 600; margin-bottom: 12rpx; }
.empty-hint { font-size: 26rpx; color: #999; margin-bottom: 72rpx; }

.empty-add-btn {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  background: linear-gradient(135deg, #FF8096, #FF9EAA); color: #FFFFFF;
  border-radius: 44rpx;
  padding: 26rpx 88rpx; font-size: 28rpx; font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(255, 128, 150, 0.35);
}

.empty-add-btn:active { transform: scale(0.96); }

.empty-add-icon { width: 24rpx; height: 24rpx; position: relative; }
.empty-add-icon::before,
.empty-add-icon::after {
  content: ''; position: absolute; background: #FFFFFF; border-radius: 3rpx;
}
.empty-add-icon::before { width: 100%; height: 3rpx; top: 50%; transform: translateY(-50%); }
.empty-add-icon::after { width: 3rpx; height: 100%; left: 50%; transform: translateX(-50%); }

/* ---- 加载中 ---- */
.loading-state { display: flex; justify-content: center; padding: 120rpx 0; }
.loading-dots { display: flex; gap: 16rpx; }

.dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; background: #FF8096;
  animation: dot-bounce 1.4s ease-in-out infinite both;
}

.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.16s; }
.dot:nth-child(3) { animation-delay: 0.32s; }

@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* ---- 底部操作栏 ---- */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-top: none;
  z-index: 10;
}

.add-btn {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  background: linear-gradient(135deg, #FF8096, #FF9EAA); color: #FFFFFF;
  border-radius: 44rpx;
  padding: 26rpx 0; font-size: 28rpx; font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(255, 128, 150, 0.35);
}

.add-btn:active { transform: scale(0.97); }

.add-btn-icon { width: 22rpx; height: 22rpx; position: relative; }
.add-btn-icon::before,
.add-btn-icon::after { content: ''; position: absolute; background: #FFFFFF; border-radius: 3rpx; }
.add-btn-icon::before { width: 100%; height: 4rpx; top: 50%; transform: translateY(-50%); }
.add-btn-icon::after { width: 4rpx; height: 100%; left: 50%; transform: translateX(-50%); }
