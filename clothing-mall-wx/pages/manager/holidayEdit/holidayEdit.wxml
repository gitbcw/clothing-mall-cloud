<wxs src="../../../utils/image.wxs" module="img" />
<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight + 16}}px; height: {{navBarHeight}}px;">
    <view class="nav-inner">
      <view class="nav-back" bindtap="onBack">
        <view class="nav-back-icon"></view>
      </view>
      <view class="nav-title">{{isEdit ? '编辑活动' : '新建活动'}}</view>
      <view class="nav-action" bindtap="onSave">
        <text class="nav-save-text">保存</text>
      </view>
    </view>
  </view>
  <view class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight + 16}}px;"></view>

  <!-- 表单 -->
  <view class="form-section">
    <view class="form-card">
      <!-- 名称 -->
      <view class="form-item">
        <text class="form-label">活动名称</text>
        <input class="form-input" placeholder="如：春节特惠" value="{{form.name}}" bindinput="onInputName" />
      </view>

      <!-- 日期范围 -->
      <view class="form-item">
        <text class="form-label">开始日期</text>
        <picker mode="date" value="{{form.startDate}}" bindchange="onStartDateChange">
          <view class="form-picker">
            <text class="{{form.startDate ? 'picker-value' : 'picker-placeholder'}}">
              {{form.startDate || '选择开始日期'}}
            </text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">结束日期</text>
        <picker mode="date" value="{{form.endDate}}" bindchange="onEndDateChange">
          <view class="form-picker">
            <text class="{{form.endDate ? 'picker-value' : 'picker-placeholder'}}">
              {{form.endDate || '选择结束日期'}}
            </text>
          </view>
        </picker>
      </view>

      <!-- 排序 -->
      <view class="form-item">
        <text class="form-label">排序权重</text>
        <view class="sort-control">
          <view class="sort-btn" bindtap="onSortMinus">-</view>
          <text class="sort-value">{{form.sortOrder}}</text>
          <view class="sort-btn" bindtap="onSortPlus">+</view>
        </view>
      </view>

      <!-- 启用 -->
      <view class="form-item">
        <text class="form-label">启用状态</text>
        <view class="toggle-switch {{form.enabled ? 'switch-on' : 'switch-off'}}" bindtap="onToggleEnabled">
          <view class="switch-dot"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 关联商品 -->
  <view class="goods-section">
    <view class="section-header">
      <text class="section-title">关联商品 ({{goodsList.length}})</text>
      <view class="add-goods-btn" bindtap="onAddGoods">
        <text>+ 添加</text>
      </view>
    </view>

    <view class="goods-list" wx:if="{{goodsList.length > 0}}">
      <view class="goods-item" wx:for="{{goodsList}}" wx:key="id">
        <image class="goods-img" src="{{img.url(item.picUrl)}}" mode="aspectFill" />
        <view class="goods-info">
          <text class="goods-name">{{item.name}}</text>
          <text class="goods-price">¥{{item.retailPrice}}</text>
        </view>
        <view class="goods-remove" catchtap="onRemoveGoods" data-index="{{index}}">
          <text class="remove-x">×</text>
        </view>
      </view>
    </view>

    <view class="goods-empty" wx:if="{{goodsList.length === 0}}">
      <text class="goods-empty-text">暂未关联商品</text>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-bar">
    <view class="save-btn {{saving ? 'btn-disabled' : ''}}" bindtap="onSave">
      <text>{{saving ? '保存中...' : '保存'}}</text>
    </view>
  </view>
</view>
