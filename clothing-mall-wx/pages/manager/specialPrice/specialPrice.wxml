<wxs src="../../../utils/image.wxs" module="img" />
<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight + 16}}px; height: {{navBarHeight}}px;">
    <view class="nav-inner">
      <view class="nav-back" bindtap="onBack">
        <view class="nav-back-icon"></view>
      </view>
      <view class="nav-title">特价管理</view>
    </view>
  </view>
  <view class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight + 16}}px;"></view>

  <!-- 商品列表 -->
  <view class="goods-list" wx:if="{{!loading || goodsList.length > 0}}">
    <view class="goods-item" wx:for="{{goodsList}}" wx:key="id">
      <!-- 复选框（批量模式） -->
      <view class="goods-checkbox" wx:if="{{batchMode}}" catchtap="onToggleSelect" data-id="{{item.id}}">
        <view class="checkbox-inner {{item._selected ? 'checked' : ''}}"></view>
      </view>

      <image class="goods-img" src="{{img.url(item.picUrl)}}" mode="aspectFill" />
      <view class="goods-info">
        <text class="goods-name">{{item.name}}</text>
        <view class="price-row">
          <text class="original-price">¥{{item.retailPrice}}</text>
          <text class="special-price" wx:if="{{item.specialPrice}}">特价 ¥{{item.specialPrice}}</text>
        </view>
      </view>

      <!-- 编辑按钮（非批量模式） -->
      <view class="edit-btn" wx:if="{{!batchMode}}" catchtap="onEditPrice" data-id="{{item.id}}" data-price="{{item.specialPrice}}">
        <text class="edit-text">改价</text>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}" bindtap="onReachBottom">
      <text class="load-more-text">{{loading ? '加载中...' : '加载更多'}}</text>
    </view>
    <view class="list-end" wx:if="{{!hasMore && goodsList.length > 0}}">
      <text class="list-end-text">共 {{total}} 件特价商品</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && goodsList.length === 0}}">
    <view class="empty-icon"></view>
    <text class="empty-text">暂无特价商品</text>
    <text class="empty-hint">添加特价商品，吸引更多顾客</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading && goodsList.length === 0}}">
    <view class="loading-dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
  </view>

  <!-- 底部操作栏（非批量模式） -->
  <view class="bottom-bar" wx:if="{{!batchMode && !loading}}">
    <view class="bar-btn bar-btn-ghost" bindtap="onToggleBatch">
      <text>管理</text>
    </view>
    <view class="bar-btn bar-btn-primary" bindtap="onShowAddPopup">
      <text>+ 添加特价</text>
    </view>
  </view>

  <!-- 底部操作栏（批量模式） -->
  <view class="bottom-bar" wx:if="{{batchMode}}">
    <view class="batch-info">
      <text>已选 {{selectedIds.length}} 件</text>
    </view>
    <view class="bar-btn bar-btn-danger" bindtap="onShowCancelPopup">
      <text>取消特价</text>
    </view>
  </view>

  <!-- 添加特价弹窗 -->
  <view class="popup-mask" wx:if="{{showAddPopup}}" bindtap="onHideAddPopup"></view>
  <view class="popup-container" wx:if="{{showAddPopup}}">
    <view class="popup-header">
      <text class="popup-title">添加特价商品</text>
      <view class="popup-close" bindtap="onHideAddPopup">×</view>
    </view>

    <!-- 搜索 -->
    <view class="popup-search">
      <input class="search-input" placeholder="搜索商品名称" value="{{searchKeyword}}" bindinput="onSearchInput" />
    </view>

    <!-- 统一特价 -->
    <view class="price-set">
      <text class="price-label">统一特价</text>
      <input class="price-input" type="digit" placeholder="选填" value="{{addSpecialPrice}}" bindinput="onAddPriceInput" />
    </view>

    <!-- 搜索结果 -->
    <view class="popup-list">
      <view class="popup-item" wx:for="{{searchResults}}" wx:key="id" bindtap="onToggleAddSelect" data-id="{{item.id}}">
        <view class="popup-checkbox {{item._selected ? 'checked' : ''}}"></view>
        <image class="popup-img" src="{{img.url(item.picUrl)}}" mode="aspectFill" />
        <view class="popup-info">
          <text class="popup-name">{{item.name}}</text>
          <text class="popup-price">¥{{item.retailPrice}}</text>
        </view>
      </view>
      <view class="popup-load-more" wx:if="{{searchHasMore}}" bindtap="onSearchMore">
        <text>加载更多</text>
      </view>
    </view>

    <!-- 确认 -->
    <view class="popup-footer">
      <view class="popup-confirm" bindtap="onConfirmAdd">
        <text>确认添加 ({{addSelectedIds.length}})</text>
      </view>
    </view>
  </view>

  <!-- 取消特价确认弹窗 -->
  <view class="popup-mask" wx:if="{{showCancelPopup}}" bindtap="onHideCancelPopup"></view>
  <view class="confirm-popup" wx:if="{{showCancelPopup}}">
    <text class="confirm-title">确认取消特价</text>
    <text class="confirm-desc">将取消 {{selectedIds.length}} 件商品的特价标记</text>
    <view class="confirm-btns">
      <view class="confirm-cancel" bindtap="onHideCancelPopup">取消</view>
      <view class="confirm-ok" bindtap="onConfirmCancel">确认</view>
    </view>
  </view>
</view>
