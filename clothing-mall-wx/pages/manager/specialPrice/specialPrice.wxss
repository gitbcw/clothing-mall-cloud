@import "../../../styles/manager-common.wxss";

.container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ---- 导航栏 ---- */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(20px);
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  position: relative;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #333;
  border-bottom: 4rpx solid #333;
  transform: rotate(45deg);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.nav-placeholder {
  background: transparent;
}

/* ---- 商品列表 ---- */
.goods-list {
  padding: 20rpx 24rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.goods-checkbox {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.checkbox-inner {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #DDD;
  transition: all 0.15s;
}

.checkbox-inner.checked {
  background: #FF8096;
  border-color: #FF8096;
}

.goods-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.goods-info {
  flex: 1;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8rpx;
}

.price-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.special-price {
  font-size: 26rpx;
  color: #FF4444;
  font-weight: 600;
}

.edit-btn {
  padding: 8rpx 20rpx;
  background: rgba(255, 128, 150, 0.1);
  border-radius: 24rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.edit-text {
  font-size: 24rpx;
  color: #FF8096;
  font-weight: 500;
}

/* ---- 加载更多/底部 ---- */
.load-more {
  text-align: center;
  padding: 30rpx;
}

.load-more-text {
  font-size: 24rpx;
  color: #999;
}

.list-end {
  text-align: center;
  padding: 30rpx;
}

.list-end-text {
  font-size: 24rpx;
  color: #CCC;
}

/* ---- 空状态 ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 128, 150, 0.1), rgba(255, 128, 150, 0.05));
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #BBB;
}

/* ---- 加载中 ---- */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-dots { display: flex; gap: 12rpx; }
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FF8096;
  animation: dot-bounce 1.4s ease-in-out infinite both;
}
.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.16s; }
.dot:nth-child(3) { animation-delay: 0.32s; }
@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* ---- 底部操作栏 ---- */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.bar-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.bar-btn:active { opacity: 0.85; }

.bar-btn-primary {
  background: #FF8096;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 128, 150, 0.3);
}

.bar-btn-ghost {
  background: rgba(255, 128, 150, 0.1);
  color: #FF8096;
}

.bar-btn-danger {
  background: #E8494A;
  color: #FFFFFF;
}

.batch-info {
  font-size: 26rpx;
  color: #666;
}

/* ---- 弹窗 ---- */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.popup-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  display: flex;
  flex-direction: column;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.popup-close {
  font-size: 40rpx;
  color: #999;
  padding: 0 10rpx;
}

.popup-search {
  padding: 20rpx 30rpx;
}

.search-input {
  background: #F5F5F5;
  border-radius: 32rpx;
  padding: 16rpx 30rpx;
  font-size: 26rpx;
}

.price-set {
  display: flex;
  align-items: center;
  padding: 10rpx 30rpx 20rpx;
  gap: 20rpx;
}

.price-label {
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.price-input {
  flex: 1;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
}

.popup-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 30rpx;
  max-height: 50vh;
}

.popup-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.popup-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #DDD;
  margin-right: 16rpx;
  flex-shrink: 0;
  transition: all 0.15s;
}

.popup-checkbox.checked {
  background: #FF8096;
  border-color: #FF8096;
}

.popup-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.popup-info {
  flex: 1;
  min-width: 0;
}

.popup-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.popup-price {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.popup-load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #999;
}

.popup-footer {
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F0F0F0;
}

.popup-confirm {
  background: #FF8096;
  color: #FFFFFF;
  text-align: center;
  border-radius: 44rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
  font-weight: 500;
}

.popup-confirm:active { opacity: 0.85; }

/* ---- 确认弹窗 ---- */
.confirm-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  z-index: 201;
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
}

.confirm-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.confirm-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 40rpx;
}

.confirm-btns {
  display: flex;
  gap: 20rpx;
}

.confirm-cancel {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: #666;
  background: #F5F5F5;
}

.confirm-ok {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  background: #E8494A;
}

.confirm-cancel:active,
.confirm-ok:active { opacity: 0.85; }
