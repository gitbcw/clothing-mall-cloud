@import "../../../styles/manager-common.wxss";

.container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ---- 导航栏 ---- */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #333;
  border-bottom: 4rpx solid #333;
  transform: rotate(45deg);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-placeholder-right {
  width: 60rpx;
}

.nav-placeholder {
  background: transparent;
}

/* ---- 表单区域 ---- */
.form-section {
  padding: 20rpx 24rpx;
}

.form-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ---- 内置背景 ---- */
.section-subtitle {
  font-size: 24rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 16rpx;
}

.builtin-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.builtin-item {
  position: relative;
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.builtin-preview {
  width: 100%;
  height: 100rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  margin-bottom: 8rpx;
}

.builtin-preview-none {
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.builtin-none-icon {
  font-size: 28rpx;
  color: #ccc;
}

.builtin-name {
  font-size: 20rpx;
  color: #666;
}

.builtin-item-active .builtin-preview {
  border-color: #FF8096;
  border-width: 3rpx;
}

.builtin-item-active .builtin-name {
  color: #FF8096;
  font-weight: 500;
}

.builtin-check {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 28rpx;
  height: 28rpx;
  background: #FF8096;
  border-radius: 50%;
}

.builtin-check::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -60%) rotate(45deg);
  width: 12rpx;
  height: 6rpx;
  border-bottom: 3rpx solid #fff;
  border-right: 3rpx solid #fff;
}

/* ---- 分隔线 ---- */
.section-divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e8e8e8;
}

.divider-text {
  font-size: 22rpx;
  color: #bbb;
  white-space: nowrap;
}

/* ---- 图片上传 ---- */
.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.field-hint {
  font-size: 22rpx;
  color: #999;
}

.poster-upload {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #487EB0;
  background: linear-gradient(135deg, #F4F8FC, #EFF5FA);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.upload-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(72, 126, 176, 0.15);
  position: relative;
}

.upload-icon::before,
.upload-icon::after {
  content: '';
  position: absolute;
  background: #487EB0;
  border-radius: 2rpx;
}

.upload-icon::before {
  width: 50%;
  height: 3rpx;
  top: 50%;
  left: 25%;
  transform: translateY(-50%);
}

.upload-icon::after {
  width: 3rpx;
  height: 50%;
  left: 50%;
  top: 25%;
  transform: translateX(-50%);
}

.upload-text {
  font-size: 24rpx;
  color: #487EB0;
}

.uploading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E8F0F7;
  border-top-color: #487EB0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.poster-preview {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.poster-image {
  width: 100%;
  height: 100%;
}

.poster-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 20rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.poster-btn {
  font-size: 22rpx;
  color: #FFFFFF;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(8px);
}

.poster-btn:active {
  background: rgba(255, 255, 255, 0.4);
}

.poster-btn-delete {
  background: rgba(232, 73, 74, 0.6);
}

.poster-btn-delete:active {
  background: rgba(232, 73, 74, 0.8);
}

/* ---- 保存按钮 ---- */
.save-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  z-index: 10;
}

.save-btn {
  background: #FF8096;
  color: #FFFFFF;
  border-radius: 44rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(255, 128, 150, 0.3);
}

.save-btn:active {
  opacity: 0.85;
}

.save-btn-disabled {
  opacity: 0.5;
}

/* ---- 生日券配置区块 ---- */
.config-section {
  padding: 20rpx 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.section-accent {
  width: 6rpx;
  height: 28rpx;
  background: #FF8096;
  border-radius: 3rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.config-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label-inline {
  font-size: 26rpx;
  color: #333;
  flex-shrink: 0;
}

/* ---- Toggle Switch ---- */
.toggle-switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  position: relative;
  transition: background 0.3s;
}

.switch-off {
  background: #e0e0e0;
}

.switch-on {
  background: #FF8096;
}

.switch-dot {
  width: 40rpx;
  height: 40rpx;
  background: #FFFFFF;
  border-radius: 50%;
  position: absolute;
  top: 4rpx;
  transition: left 0.3s;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

.switch-off .switch-dot {
  left: 4rpx;
}

.switch-on .switch-dot {
  left: 44rpx;
}

/* ---- Picker & Input ---- */
.form-picker {
  flex: 1;
  text-align: right;
}

.picker-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.form-placeholder {
  color: #bbb;
  font-size: 24rpx;
}

.form-arrow {
  color: #ccc;
  font-size: 24rpx;
}

.form-input {
  width: 160rpx;
  text-align: right;
  font-size: 26rpx;
  color: #333;
}
