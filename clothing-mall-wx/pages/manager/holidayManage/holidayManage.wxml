<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight + 16}}px; height: {{navBarHeight}}px;">
    <view class="nav-inner">
      <view class="nav-back" bindtap="onBack">
        <view class="nav-back-icon"></view>
      </view>
      <view class="nav-title">节日活动</view>
      <view class="nav-action" bindtap="onAddHoliday">
        <view class="nav-add-icon"></view>
      </view>
    </view>
  </view>
  <view class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight + 16}}px;"></view>

  <!-- 节日列表 -->
  <view class="holiday-list" wx:if="{{!loading}}">
    <view class="holiday-card" wx:for="{{holidayList}}" wx:key="id" bindtap="onHolidayTap" data-id="{{item.id}}">
      <view class="holiday-info">
        <view class="holiday-name">{{item.name}}</view>
        <view class="holiday-date">{{item.start_date}} ~ {{item.end_date}}</view>
        <view class="holiday-meta">
          <text class="holiday-sort">排序 {{item.sort_order || 0}}</text>
          <view class="holiday-status status-{{item.statusType}}">{{item.statusText}}</view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="holiday-actions">
        <view class="action-btn" catchtap="onToggleEnable" data-id="{{item.id}}" data-enabled="{{item.enabled}}">
          <view class="toggle-icon {{item.enabled ? 'toggle-on' : 'toggle-off'}}"></view>
        </view>
        <view class="action-btn" catchtap="onDeleteHoliday" data-id="{{item.id}}">
          <view class="delete-icon"></view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{holidayList.length === 0}}">
      <view class="empty-icon"></view>
      <text class="empty-text">还没有节日活动</text>
      <text class="empty-hint">创建节日活动，关联促销商品</text>
      <view class="empty-add-btn" bindtap="onAddHoliday">
        <view class="empty-add-icon"></view>
        <text>创建活动</text>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar" wx:if="{{!loading && holidayList.length > 0}}">
    <view class="add-btn" bindtap="onAddHoliday">
      <view class="add-btn-icon"></view>
      <text>新增活动</text>
    </view>
  </view>
</view>
